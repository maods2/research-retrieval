{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                    "--config",
                    "${workspaceFolder}/configs/testing/few-shot-test.yaml",
                    "--pipeline",
                    "train"
                ]
        },
        {
            "name": "Debug E2E training loop",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--config",
                "${workspaceFolder}/configs/testing/train-att-metric.yml",
                "--pipeline",
                "train"
            ],
            "env": {
                "HF_TOKEN": "YOUR_TOKEN"
            },
            "python": "<PATH_TO_YOUR_ENV>/bin/python3"
        },
    ]
}
